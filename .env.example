# Copy this to .env (which is gitignored) and fill it in.

# The folder Google Drive syncs the timetracker app's automatic database backups into
TIMETRACKER_DRIVE_FOLDER=H:\My Drive\com.aadhk.time

# A month's total hours round up if the minutes past the whole hour are more than
# this, and down otherwise. A client can override this with
# rounding_threshold_minutes in the META section of its config
ROUNDING_THRESHOLD_MINUTES=30

# Only for pnpm email-invoices, which creates Gmail drafts. The OAuth client
# (a "Desktop app") that you download from the Google Cloud console, and where
# the token that approving access gives is kept. Both are gitignored if they
# are called .gmail-*.json
GMAIL_CREDENTIALS_FILE=./.gmail-credentials.json
GMAIL_TOKEN_FILE=./.gmail-token.json
